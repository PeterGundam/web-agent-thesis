`;_.Hk=Dk(()=>{Ck(Gk)});var Ik;Ik=vk`
  .ocWebScrim {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: transparent;
    z-index: 15000;
  }

  .ocWebScrim.ocWebVisibleScrim {
    background-color: rgba(0, 0, 0, 0.32);
  }

  .ocWebDialog {
    height: 640px;
    max-height: 100%;
    width: 480px;
    max-width: 100%;
    border-radius: 32px 32px 0 0;
    overflow: hidden;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
    box-shadow: 0px 4px 8px 3px rgba(0, 0, 0, 0.15),
                0px 1px 3px 0px rgba(0, 0, 0, 0.30);
  }

  .ocWebDialog.dark {
    background-color: rgb(30, 31, 32);
  }

  .ocWebDialog.light {
    background-color: rgb(240, 244, 249);
  }

  @media (min-width: 480px) {
    .ocWebDialog {
      margin: auto;
      top: 0;
      border-radius: 32px;
    }

    .ocWebDialog.positionTopRight {
      margin: unset;
      left: unset;
      top: 65px;
      right: 16px;
    }
  }
